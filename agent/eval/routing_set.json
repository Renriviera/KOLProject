{
  "about": "Routing test set for the CAR-T KOL Navigator: questions with the skill, entity ids, queries, map and caveats a correct answer must use. Scored by `uv run kolproject-agent-eval`. Ids are community ids, hospital CCNs and NPIs from the published tables.",
  "fields": {
    "skill": "skills that should answer the question; tested when data or the inventory is shown, not for a question back or a refusal. Another skill also counts as right if it ran the queries the question requires",
    "outcome": "view (data shown), ask (a question back to the user), decline (nothing shown from the database), help (the inventory of what can be asked)",
    "ids": "every entry must appear in a query parameter or in the map focus; an entry written as a list means any one of them",
    "queries": "every one must be run",
    "queries_any": "at least one must be run",
    "params": "each must be a parameter of at least one query run; a list means any of the values",
    "focus": "kind of the map focus",
    "edges": "map links that fit the question",
    "caveats": "caveat codes that must be printed",
    "memory": "what the user was looking at before the question; a follow-up refers to it, a new-topic question names something else and must not be answered about it",
    "text_has": "words the answer must contain; a list means any one of the phrases"
  },
