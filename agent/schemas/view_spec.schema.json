{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "view_spec.schema.json",
  "title": "ViewSpec",
  "description": "What one agent turn asks the interface to show. The server assembles it from the agent's set_map, add_panel and final_answer calls and validates it before anything is drawn. It carries no data values: every panel points to a query handle, and the interface reads the rows from the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map",
    "panels",
    "answer"
  ],
  "properties": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus",
        "show",
        "edges"
      ],
      "properties": {
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ids"
          ],
          "properties": {
            "kind": {
              "enum": [
                "community",
                "center",
                "hcp",
                "state",
                "usa"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 6
            }
          }
        },
        "show": {
          "enum": [
            "focus_only",
            "focus_and_linked",
            "all"
          ],
          "description": "focus_only removes every point outside the focus; focus_and_linked keeps points joined to it by the chosen edges; all keeps the national picture."
        },
        "edges": {
          "enum": [
            "coauthor",
            "referral",
            "payments",
            "none"
          ]
        },
        "highlight": {
          "oneOf": [
            {
              "enum": [
                "leaders",
                "main_centers",
                "none"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 25
            }
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 2017,
          "maximum": 2026
        },
        "unchanged": {
          "type": "boolean",
          "description": "true when the turn did not call set_map; the interface keeps the previous map."
        }
      }
    },
    "panels": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "type": {
            "enum": [
              "kpis",
              "table",
              "bar",
              "line",
              "timeline",
              "ranked_list",
              "text"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 90
          },
          "handle": {
            "type": "string",
            "description": "Query result to draw. Required for every type except text."
          },
          "span": {
            "enum": [
              "full",
              "half",
              "third"
            ],
            "description": "Width on the 12-column canvas. The interface picks a default per type when absent."
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "string"
              },
              "y": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 4
              },
              "split_by": {
                "type": "string",
                "maxLength": 40,
                "description": "A column of the query result to split a chart by."
              },
              "markers": {
                "oneOf": [
                  {
                    "enum": [
                      "lymphoma_products",
                      "all_products",
                      "none"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "enum": [
                        "Kymriah",
                        "Yescarta",
                        "Tecartus",
                        "Breyanzi",
                        "Abecma",
                        "Carvykti",
                        "Aucatzyl"
                      ]
                    }
                  }
                ]
              },
              "top_n": {
                "type": "integer",
                "minimum": 3,
                "maximum": 50
              },
              "body": {
                "type": "string",
                "maxLength": 600,
                "description": "Only for type text."
              }
            }
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "text",
        "caveats"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "maxLength": 1200
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "REFERRAL",
              "MEDICARE",
              "MEDICAID",
              "NOT_PRODUCT_SPECIFIC",
              "PAYMENTS",
              "TIES",
              "LABELS",
              "CORE_ONLY"
            ]
          }
        }
      }
    },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "choices"
      ],
      "description": "Present only when the agent needs the user to choose between candidates before it can answer.",
      "properties": {
        "question": {
          "type": "string",
          "maxLength": 200
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    }
  }
}
