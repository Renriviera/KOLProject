Data/raw/
Data/interim/
Data/legacy/
evaluations/runs/
evaluations/multirun/
*.log
.pytest_cache/
.DS_Store
*.zip


# Dataset payloads and generated reports stay in the complete local project.
Data/*
!Data/UTILIZATION_README.md
edav/*
!edav/README.md
evaluations/*
!evaluations/README.md
models/*
!models/README.md
.env
.env.*
