# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Source responses are included in the project archive and tracked by SHA-256
# in Data/manifests, rather than duplicated in Git history.
Data/raw/
Data/interim/
Data/legacy/
evaluations/runs/
evaluations/multirun/
*.log
.pytest_cache/
.DS_Store
*.zip


# Keep bulky source inputs local; processed tables and curated outputs are versioned.
Data/references/
Data/manifests/source_requests.csv
Data/manifests/data_file_checksums.csv
Data/manifests/*/utilization_source_requests.csv
Data/manifests/*/utilization_file_checksums.csv
models/inputs/*.csv
models/inputs/*.metadata.json
.cache/
.env
.env.*

# Machine-local inputs and recoverable pre-consolidation history.
configs/local/
.local-backups/
Data/manifests/source_catalog.json

# Outputs from the original layout are retained locally for provenance.
edav/*
!edav/README.md
evaluations/validation_report.json
evaluations/utilization_validation_2026-10-15.json
evaluations/release_integrity.json
